   "source": [
    "---\n",
    "# 🏋️ 7. Explicitní trénovací a validační smyčka (Krok 1.5 dle zadání)\n",
    "> **Splnění klíčového požadavku zadání:** *\"Explicit training loop: write the complete training and validation loops manually — optimizer.zero_grad(), loss.backward(), optimizer.step(), and metric accumulation across batches.\"*\n",
    "\n",
    "Trénovací smyčka je napsána v **čistém PyTorch** přesně podle zásad kurzu z [`PRINCIPLES.md`](PRINCIPLES.md):\n",
    "1. **Striktní střídání režimů:** `model.train()` (zapnutý Dropout a sledování statistik v BatchNorm) vs. `model.eval()` (vypnutý Dropout, fixní statistiky BatchNorm).\n",
    "2. **Validační fáze bez gradientů:** Výhradně pod kontextem `with torch.no_grad():` (šetří paměť a nevytváří výpočetní graf).\n",
    "3. **Pět kanonických kroků iterace:** `optimizer.zero_grad()` $\\to$ `logits = model(xb)` $\\to$ `loss = criterion(logits, yb)` $\\to$ `loss.backward()` $\\to$ `optimizer.step()`.\n",
    "4. **Korektní agregace:** Ztráta každé dávky se násobí skutečnou velikostí `xb.size(0)` a na konci epochy dělí `len(dataset)` — tím se zamezí zkreslení u posledního neúplného batche.\n",
    "5. **Checkpointing nejlepšího modelu:** Po každé epoše porovnáme validační ztrátu a při zlepšení uložíme váhy pomocí `torch.save(model.state_dict(), 'best_baseline.pt')`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Funkce train_model úspěšně definována.\n"
     ]
    }
   ],
   "source": [
    "# 7.1 Implementace explicitní trénovací a validační funkce v čistém PyTorch\n",
    "def train_model(model, train_loader, val_loader, criterion, optimizer, n_epochs=12, device=device, ckpt_path='best_baseline.pt'):\n",
    "    history = {\"train_loss\": [], \"val_loss\": [], \"train_acc\": [], \"val_acc\": []}\n",
    "    best_val_loss = float(\"inf\")\n",
    "    \n",
    "    print(f\"=== Zahájení trénování na {n_epochs} epoch (Device: {device}) ===\")\n",
    "    print(\"-\" * 75)\n",
    "    \n",
    "    for epoch in range(1, n_epochs + 1):\n",
    "        # -------------------------------------------------------------\n",
    "        # FÁZE 1: Trénování (Training Phase)\n",
    "        # -------------------------------------------------------------\n",
    "        model.train()  # Aktivace trénovacího režimu (Dropout + BatchNorm)\n",
    "        running_train_loss = 0.0\n",
    "        running_train_correct = 0\n",
    "        total_train_samples = 0\n",
    "        \n",
    "        for xb, yb in train_loader:\n",
    "            xb, yb = xb.to(device), yb.to(device)\n",
    "            \n",
    "            optimizer.zero_grad()           # 1. Vynulování gradientů\n",
    "            logits = model(xb)              # 2. Forward pass\n",
    "            loss = criterion(logits, yb)    # 3. Výpočet ztrátové funkce\n",
    "            loss.backward()                 # 4. Backward pass (autograd)\n",
    "            optimizer.step()                # 5. Aktualizace vah\n",
    "            \n",
    "            batch_size = xb.size(0)\n",
    "            running_train_loss += loss.item() * batch_size\n",
    "            running_train_correct += (logits.argmax(dim=1) == yb).sum().item()\n",
    "            total_train_samples += batch_size\n",
    "        \n",
    "        epoch_train_loss = running_train_loss / total_train_samples\n",
    "        epoch_train_acc  = (running_train_correct / total_train_samples) * 100.0\n",
    "        \n",
    "        # -------------------------------------------------------------\n",
    "        # FÁZE 2: Validace (Validation Phase)\n",
    "        # -------------------------------------------------------------\n",
    "        model.eval()   # Aktivace evaluačního režimu\n",
    "        running_val_loss = 0.0\n",
    "        running_val_correct = 0\n",
    "        total_val_samples = 0\n",
    "        \n",
    "        with torch.no_grad():  # Vypnutí výpočtu gradientů\n",
    "            for xb, yb in val_loader:\n",
    "                xb, yb = xb.to(device), yb.to(device)\n",
    "                logits = model(xb)\n",
    "                loss = criterion(logits, yb)\n",
    "                \n",
    "                batch_size = xb.size(0)\n",
    "                running_val_loss += loss.item() * batch_size\n",
    "                running_val_correct += (logits.argmax(dim=1) == yb).sum().item()\n",
    "                total_val_samples += batch_size\n",
    "        \n",
    "        epoch_val_loss = running_val_loss / total_val_samples\n",
    "        epoch_val_acc  = (running_val_correct / total_val_samples) * 100.0\n",
    "        \n",
    "        # Uložení do historie\n",
    "        history[\"train_loss\"].append(epoch_train_loss)\n",
    "        history[\"val_loss\"].append(epoch_val_loss)\n",
    "        history[\"train_acc\"].append(epoch_train_acc)\n",
    "        history[\"val_acc\"].append(epoch_val_acc)\n",
    "        \n",
    "        # Checkpointování nejlepšího modelu\n",
    "        is_best = epoch_val_loss < best_val_loss\n",
    "        best_marker = \"\"\n",
    "        if is_best:\n",
    "            best_val_loss = epoch_val_loss\n",
    "            torch.save(model.state_dict(), ckpt_path)\n",
    "            best_marker = \" ⭐ [ULOŽEN CHECKPOINT]\"\n",
    "        \n",
    "        print(f\"Epocha {epoch:2d}/{n_epochs:2d} | \"\n",
    "              f\"Train Loss: {epoch_train_loss:.4f} | Val Loss: {epoch_val_loss:.4f} | \"\n",
    "              f\"Train Acc: {epoch_train_acc:5.2f}% | Val Acc: {epoch_val_acc:5.2f}%{best_marker}\")\n",
    "    \n",
    "    print(\"-\" * 75)\n",
    "    print(f\"Trénování dokončeno! Načítám nejlepší váhy z: {ckpt_path} (Nejnižší Val Loss: {best_val_loss:.4f})\")\n",
    "    model.load_state_dict(torch.load(ckpt_path))\n",
    "    return history\n",
    "\n",
    "print(\"Funkce train_model úspěšně definována.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [
    {
